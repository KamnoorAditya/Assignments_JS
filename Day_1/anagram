function anagram(){
        let str1=prompt("Enter string 1:");
        let str2=prompt("Enter string 2:");
        if(str1.length!==str2.length){
                return false;
        }
        let arr1=str1.split("").sort().join("");
        let arr2=str2.split('').sort().join("")
        return arr1==arr2;
        
}
console.log(anagram())