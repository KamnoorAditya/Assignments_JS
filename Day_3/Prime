let n=prompt("enter a number:");
let prime=true;
function check_prime(){
        if (n<2){
                return false
        }
        for(let i=2;i<n;i++){
                if(n%i==0){
                    
                    return false;
                }

        }
        if(prime){
               return "prime"
        }
}
console.log(check_prime(n));