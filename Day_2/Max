function findMax(arr) {
    let max = arr[0];

    for (let i = 1; i < arr.length; i++) {
        if (arr[i] > max) {
            max = arr[i];
        }
    }

    return max;
}

let len = Number(prompt("Enter the size of the array:"));
let arr = [];

for (let i = 0; i < len; i++) {
    arr[i] = Number(prompt("Enter number:"));
}

console.log("Maximum value:", findMax(arr));