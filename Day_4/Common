let n1 = Number(prompt("Enter size of first array:"));
let arr1 = [];

for (let i = 0; i < n1; i++) {
    arr1[i] = Number(prompt("Enter element:"));
}

let n2 = Number(prompt("Enter size of second array:"));
let arr2 = [];

for (let i = 0; i < n2; i++) {
    arr2[i] = Number(prompt("Enter element:"));
}

let common = [];
let k = 0;

for (let i = 0; i < n1; i++) {
    for (let j = 0; j < n2; j++) {
        if (arr1[i] === arr2[j]) {
            common[k] = arr1[i];
            k++;
            break;
        }
    }
}

console.log("Common elements:", common);